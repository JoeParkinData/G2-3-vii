\f0\fs24 \cf0 // The following generates subgroups of E_8(3) in its adjoint representation isomorphic to G_2(3) following feasible decomposition (vii).\
// In order to run this, one must download the files from the repository A-Sylow-2-and-overgroups and run the code from ReadSyl2. We will also need the file "ElAb8s2BConj" from the repository Various-2-subgroups, and the functions chainloader and TwoGroupNormalizer associated to the paper of Rowley and Taylor\
// Note that the eval Read lines may need altering according to file directory.\
\
Es:=eval Read("ElAb8s2BConj"); // load in the Elementary abelian subgroups\
E:=Es[1] @@ phi; // we know this is the only possible Sylow 2-subgroup of a G_2(3)
\f1\fs22 \cf2 \CocoaLigature0 \
\pard\tx560\tx1120\tx1680\tx2240\tx2800\tx3360\tx3920\tx4480\tx5040\tx5600\tx6160\tx6720\pardirnatural\partightenfactor0
\
//compute N_G(E)\
repeat\
 ENorm,h,b:=TwoGroupNormalizer(G,E,chainstore2,5,5);\
until b in \{(2^(22))*(3^9)*(5^4),(2^(30))*(3^9)*7\};\
ENorm:=sub<GL(248,3)|ENorm>;\
pli,ENormp:=PermutationRepresentation(ENorm);\
ENormP,Pli:=DegreeReduction(ENormp);\
\
// map to M3P\
tt,iso:=IsIsomorphic(ENormP,M3P);\
M3Psub:=Subgroups(M3P : OrderEqual:=1344);\
// obtain potential N_H(E) in M3P\
enorms:=[];\
G23:=ChevalleyGroup("G",2,3);\
aimgrp:=Normalizer(G23,ElementaryAbelianSubgroups(G23 : OrderEqual:=8)[1]`subgroup);\
for g in M3Psub do\
 if IsIsomorphic(g`subgroup,aimgrp) then\
  if #(g`subgroup meet E @ (psi*Psi)) eq 8 then\
   Append(~enorms,g`subgroup);\
  end if;\
 end if;\
end for;\
ENorms:=[];\
// map back into matrix setting\
for g in enorms do\
 Append(~ENorms, g @@ (pli*Pli*iso));\
end for;\
\
// save N_H(E)s\
PrintFileMagma("G23ElAbEightvii1Norms",ENorms);\
\
// build G2(3)s containing each N_H(E)\
G23s:=[];\
for L in ENorms do\
 //identify Y(L)\
 LSub:=Subgroups(L: OrderEqual:=96);\
 for g in LSub do\
  if IsIsomorphic(g`subgroup,SmallGroup(96,204)) then\
   Y:=g`subgroup;\
  end if;\
 end for;\
\
 YSub:=ElementaryAbelianSubgroups(Y : OrderEqual:=8);\
// identify W(Y) \
 repeat\
  repeat\
   W:=Random(YSub);\
  until W`length eq 1;\
 until not W`subgroup eq E;\
 W:=W`subgroup;\
 repeat\
  WNom,h,b:=TwoGroupNormalizer(G,W,chainstore2,10,10);\
//compute N_G(W)  \
 until b in \{(2^(22))*(3^9)*(5^4),(2^(30))*(3^9)*7\};\
 WNorm:=sub<GL(248,3)|WNom>;\
 LMGFactoredOrder(WNorm);\
// obtain perm rep\
 pli,perm:=PermutationRepresentation(WNorm);\
 Perm,Pli:=DegreeReduction(perm);\
 Yp:=Y @ (pli*Pli);\
// normalize Y within\
 YpNorm:=Normalizer(Perm,Yp);\
 YpNormC:=ConjugacyClasses(YpNorm);\
 YpNormC2:=[];\
// gather 2B involutions from N_G(Y) meet N_G(W)\
 for g in YpNormC do\
  if g[1] eq 2 then\
   if Dimension(Eigenspace(g[3] @@ (pli*Pli),1)) eq 120 then\
    Append(~YpNormC2,g);\
   end if;\
  end if;\
 end for;\
 twos120:=[];\
// need all conjugate involutions too\
 for g in YpNormC2 do\
  temp:=[g[3]];\
  repeat\
   h:=Random(YpNorm);\
   if not g[3]^h in temp then\
    Append(~temp,g[3]^h);\
   end if;\
  until #temp eq g[2];\
  for x in temp do\
   Append(~twos120,x);\
  end for;\
 end for;\
 goods:=[];\
 for g in twos120 do\
  tryov:=sub<GL(248,3)|L,g @@ (pli*Pli)>;\
// check if action on V_248 is compatible\
  if #CompositionFactors(GModule(tryov)) eq 20 then\
   cc:=0;\
// sanity check\
   for i:=1 to 10 do\
    x:=Element(tryov,2);\
    if Dimension(Eigenspace(x,1)) eq 120 then\
     cc:=cc+1;\
    end if;\
   end for;\
   if cc eq 10 then\
    Append(~goods,g);\
   end if;\
  end if;\
 end for;\
 #goods;\
// collect G2(3)s\
 for g in goods do\
  Append(~G23s,sub<GL(248,3)|L,g @@ (pli*Pli)>);\
 end for;\
end for;\
\
//check isomorphism to G2(3)\
G23s2:=[];\
for g in G23s do\
 if IsIsomorphic(g,G23) then\
  Append(~G23s2,g);\
 end if;\
end for;\
}